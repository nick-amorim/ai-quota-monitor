# ai-quota-monitor example configuration.
# Copy values into the deployment environment; do not commit real secrets.

AI_QUOTA_MONITOR_ENV=development
AI_QUOTA_MONITOR_HOST=127.0.0.1
AI_QUOTA_MONITOR_PORT=8080
AI_QUOTA_MONITOR_TIMEZONE=America/Recife

AI_QUOTA_MONITOR_DATABASE_URL=sqlite:///./data/ai-quota-monitor.sqlite3
AI_QUOTA_MONITOR_DATA_DIR=./data
AI_QUOTA_MONITOR_LOG_LEVEL=INFO

AI_QUOTA_MONITOR_USAGE_POLL_INTERVAL_MINUTES=5
AI_QUOTA_MONITOR_ANCHOR_PROMPT="Reply only with OK."
AI_QUOTA_MONITOR_ANCHOR_VERIFICATION_TIMEOUT_SECONDS=60
AI_QUOTA_MONITOR_MISSED_ANCHOR_GRACE_MINUTES=30
AI_QUOTA_MONITOR_HISTORY_RETENTION_DAYS=90
