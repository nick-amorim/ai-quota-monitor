# QuotaPilot example configuration.
# Copy values into the deployment environment; do not commit real secrets.

QUOTAPILOT_ENV=development
QUOTAPILOT_HOST=127.0.0.1
QUOTAPILOT_PORT=8080
QUOTAPILOT_TIMEZONE=America/Recife

QUOTAPILOT_DATABASE_URL=sqlite:///./data/quotapilot.sqlite3
QUOTAPILOT_DATA_DIR=./data
QUOTAPILOT_LOG_LEVEL=INFO

QUOTAPILOT_USAGE_POLL_INTERVAL_MINUTES=5
QUOTAPILOT_ANCHOR_PROMPT="Reply only with OK."
QUOTAPILOT_ANCHOR_VERIFICATION_TIMEOUT_SECONDS=60
QUOTAPILOT_MISSED_ANCHOR_GRACE_MINUTES=30
QUOTAPILOT_HISTORY_RETENTION_DAYS=90
